{
  "name": "triage-g2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "30-second hands-free Calendar, Gmail, Notion & OpenRouter/Claude AI triage HUD for Even Realities G2 glasses",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test": "vitest run",
    "server": "node server/workspace-bridge.mjs",
    "pack": "npx evenhub pack app.json ./dist -o release/triage-g2.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.2.0",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vitest": "^3.1.0"
  }
}
